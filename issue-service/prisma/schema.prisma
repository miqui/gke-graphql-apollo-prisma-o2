// Prisma schema for the issue-service GraphQL API (Jira-lite issue tracker).
//
// Lives in its own PostgreSQL database ("issuedb") on the same shared Postgres
// StatefulSet message-service uses - see k8s/postgres-init-configmap.yaml, which
// creates it alongside the "messagedb" the official postgres image bootstraps via
// POSTGRES_DB. `metrics` enables prisma.$metrics.json(), sampled in
// src/telemetry.ts, same as message-service.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Discriminates what an Issue "is" - a plain Jira-lite TASK, or the base record
// for one of the ITSM/ITIL extension tables below. The extension table (1:1 with
// the Issue) holds whatever fields are specific to that kind; Issue itself stays
// generic (title/status/priority/assignee/labels/comments) across all of them.
enum IssueKind {
  TASK
  INCIDENT
  PROBLEM
  CHANGE
  SERVICE_REQUEST
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum IncidentStatus {
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED
}

enum ProblemStatus {
  UNDER_INVESTIGATION
  // ITIL's "Known Error" - a Problem whose root cause is understood but not yet
  // fixed - is modeled as this status rather than a separate KnownError table.
  KNOWN_ERROR
  RESOLVED
}

enum ChangeType {
  STANDARD
  NORMAL
  EMERGENCY
}

enum ChangeStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IMPLEMENTED
  ROLLED_BACK
}

enum ServiceRequestStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Workspace {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  name      String    @db.VarChar(100)
  projects  Project[]

  @@map("workspaces")
}

model Project {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now()) @map("created_at")
  key         String      @db.VarChar(10)
  workspaceId String      @map("workspace_id")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  issues      Issue[]
  labels      Label[]
  slaPolicies SlaPolicy[]

  // Issue keys (e.g. "ENG-42") are unique per project, not globally, so the
  // project's short key only needs to be unique within its own workspace.
  @@unique([workspaceId, key])
  @@map("projects")
}

model Issue {
  id             String          @id @default(uuid())
  createdAt      DateTime        @default(now()) @map("created_at")
  title          String          @db.VarChar(200)
  status         IssueStatus     @default(BACKLOG)
  priority       Priority        @default(MEDIUM)
  kind           IssueKind       @default(TASK)
  assignee       String?         @db.VarChar(100)
  projectId      String          @map("project_id")
  project        Project         @relation(fields: [projectId], references: [id])
  labels         Label[]
  comments       Comment[]
  incident       Incident?
  problem        Problem?
  change         Change?
  serviceRequest ServiceRequest?

  // Matches issuesByStatus-style board views grouping/filtering by status per project.
  @@index([projectId, status])
  @@index([projectId, kind])
  @@map("issues")
}

model Label {
  id        String  @id @default(uuid())
  name      String  @db.VarChar(50)
  color     String  @db.VarChar(7)
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])
  issues    Issue[]

  @@unique([projectId, name])
  @@map("labels")
}

model Comment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  body      String    @db.VarChar(2000)
  author    String    @db.VarChar(100)
  issueId   String    @map("issue_id")
  issue     Issue     @relation(fields: [issueId], references: [id])
  parentId  String?   @map("parent_id")
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@index([issueId])
  @@map("comments")
}

model Incident {
  id          String           @id @default(uuid())
  createdAt   DateTime         @default(now()) @map("created_at")
  issueId     String           @unique @map("issue_id")
  issue       Issue            @relation(fields: [issueId], references: [id])
  severity    IncidentSeverity @default(SEV3)
  status      IncidentStatus   @default(INVESTIGATING)
  detectedAt  DateTime         @default(now()) @map("detected_at")
  resolvedAt  DateTime?        @map("resolved_at")
  // Resolved once, at creation, from the matching SlaPolicy row (see SlaPolicy
  // below) - denormalized here so reading a ticket's SLA deadline never needs a
  // policy-table join.
  slaBreachAt DateTime?        @map("sla_breach_at")
  problemId   String?          @map("problem_id")
  problem     Problem?         @relation(fields: [problemId], references: [id])

  @@index([status])
  @@index([severity])
  @@map("incidents")
}

model Problem {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now()) @map("created_at")
  issueId   String        @unique @map("issue_id")
  issue     Issue         @relation(fields: [issueId], references: [id])
  status    ProblemStatus @default(UNDER_INVESTIGATION)
  rootCause String?       @map("root_cause") @db.VarChar(2000)
  incidents Incident[]
  changes   Change[]

  @@index([status])
  @@map("problems")
}

model Change {
  id            String       @id @default(uuid())
  createdAt     DateTime     @default(now()) @map("created_at")
  issueId       String       @unique @map("issue_id")
  issue         Issue        @relation(fields: [issueId], references: [id])
  type          ChangeType   @default(NORMAL)
  status        ChangeStatus @default(DRAFT)
  plannedAt     DateTime?    @map("planned_at")
  implementedAt DateTime?    @map("implemented_at")
  // The Problem this Change resolves, if any - ITIL's "the fix that closes the
  // known error", not every Change traces back to one.
  problemId     String?      @map("problem_id")
  problem       Problem?     @relation(fields: [problemId], references: [id])

  @@index([status])
  @@index([type])
  @@map("changes")
}

model ServiceRequest {
  id             String               @id @default(uuid())
  createdAt      DateTime             @default(now()) @map("created_at")
  issueId        String               @unique @map("issue_id")
  issue          Issue                @relation(fields: [issueId], references: [id])
  requesterEmail String               @map("requester_email") @db.VarChar(255)
  category       String               @db.VarChar(50)
  status         ServiceRequestStatus @default(NEW)
  dueAt          DateTime?            @map("due_at")
  slaBreachAt    DateTime?            @map("sla_breach_at")

  @@index([status])
  @@index([category])
  @@map("service_requests")
}

// Per-project SLA targets, keyed by IssueKind and (depending on kind) either
// Incident.severity or ServiceRequest.category - e.g. "SEV1 incidents in
// project X resolve within 60 minutes". Seed-only: there is no GraphQL mutation
// for this table. Resolvers only read it, at Incident/ServiceRequest creation
// time, to compute that record's own slaBreachAt.
model SlaPolicy {
  id                      String            @id @default(uuid())
  projectId               String            @map("project_id")
  project                 Project           @relation(fields: [projectId], references: [id])
  kind                    IssueKind
  severity                IncidentSeverity?
  category                String?           @db.VarChar(50)
  responseTargetMinutes   Int?              @map("response_target_minutes")
  resolutionTargetMinutes Int               @map("resolution_target_minutes")

  @@unique([projectId, kind, severity, category])
  @@index([projectId, kind])
  @@map("sla_policies")
}
